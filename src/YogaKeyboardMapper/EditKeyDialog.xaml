<?xml version="1.0" encoding="utf-8"?>
<!-- Implicit styles don't apply to subclasses, so the Fluent dialog style must be set explicitly. -->
<ContentDialog
    x:Class="YogaKeyboardMapper.EditKeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:YogaKeyboardMapper.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="EditKeyDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary">

    <StackPanel Spacing="16" MinWidth="460">

        <InfoBar x:Name="ErrorBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning" />

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Uid="KeyHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="CodeText"
                           FontFamily="Consolas"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button x:Name="CaptureButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="OnCaptureClick" />
        </Grid>

        <!-- Same header spacing as the TextBox "Header" below. -->
        <StackPanel Spacing="8">
            <TextBlock x:Uid="PresetHeader" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CategoryBox"
                          x:Uid="CategoryBox"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnCategoryChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:PresetCategory">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox x:Name="PresetBox"
                          x:Uid="PresetBox"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          SelectionChanged="OnPresetChanged">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:ActionPreset">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Action}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ActionBox" x:Uid="ActionBox" />

                <Button x:Name="BrowseButton"
                        x:Uid="BrowseButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Click="OnBrowseClick" />
            </Grid>

            <!-- Action syntax legend: one code chip + caption per action type. -->
            <Grid ColumnSpacing="12">
                <Grid.Resources>
                    <Style x:Key="ExampleChipStyle" TargetType="Border">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    </Style>
                    <Style x:Key="ExampleCodeStyle" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="IsTextSelectionEnabled" Value="True" />
                    </Style>
                    <Style x:Key="ExampleCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <Border Style="{StaticResource ExampleChipStyle}">
                        <TextBlock Style="{StaticResource ExampleCodeStyle}" Text="ctrl+shift+t" />
                    </Border>
                    <TextBlock x:Uid="ActionExampleShortcut" Style="{StaticResource ExampleCaptionStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <Border Style="{StaticResource ExampleChipStyle}">
                        <TextBlock Style="{StaticResource ExampleCodeStyle}" Text="run:notepad" />
                    </Border>
                    <TextBlock x:Uid="ActionExampleRun" Style="{StaticResource ExampleCaptionStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <Border Style="{StaticResource ExampleChipStyle}">
                        <TextBlock Style="{StaticResource ExampleCodeStyle}" Text="url:https://…" />
                    </Border>
                    <TextBlock x:Uid="ActionExampleUrl" Style="{StaticResource ExampleCaptionStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</ContentDialog>
