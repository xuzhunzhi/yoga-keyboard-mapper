<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>YogaKeyboardMapper</RootNamespace>
    <AssemblyName>YogaKeyboardMapper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\YogaKeyboardMapper.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Fallback UI language when the Windows display language has no Strings\<lang> folder. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.2.0</Version>
    <AssemblyTitle>Yoga Keyboard Mapper</AssemblyTitle>
    <Product>Yoga Keyboard Mapper</Product>
    <Description>Remap the vendor-special keys of a Lenovo Yoga Book 9 Bluetooth keyboard.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also loaded at runtime for the window/taskbar icon and the title bar image. -->
    <Content Include="Assets\YogaKeyboardMapper.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The PNG logos are for Package.appxmanifest only. -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'None'">
    <Content Remove="Assets\*.png" />
  </ItemGroup>

  <!-- Unpackaged publish doesn't copy the app's own PRI (the UI strings), so add it explicitly. -->
  <Target Name="PublishProjectPri" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
