<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="YogaKey.EditKeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="编辑映射"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Spacing="16" MinWidth="420">

        <InfoBar x:Name="ErrorBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning" />

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="按键" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="CodeText"
                           Text="尚未捕获"
                           FontFamily="Consolas"
                           Opacity="0.7" />
            </StackPanel>

            <Button x:Name="CaptureButton"
                    Grid.Column="1"
                    Content="开始捕获"
                    VerticalAlignment="Center"
                    Click="OnCaptureClick" />
        </Grid>

        <ComboBox x:Name="PresetCombo"
                  Header="常用动作"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="选择一个预置动作"
                  SelectionChanged="OnPresetChanged" />

        <TextBox x:Name="ActionBox"
                 Header="动作"
                 PlaceholderText="如 ctrl+shift+esc / win+l / run:calc" />
    </StackPanel>
</ContentDialog>
