<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="YogaKey.EditKeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:YogaKey.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="编辑映射"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Spacing="16" MinWidth="460">

        <InfoBar x:Name="ErrorBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning" />

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="按键" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="CodeText"
                           Text="尚未捕获"
                           FontFamily="Consolas"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button x:Name="CaptureButton"
                    Grid.Column="1"
                    Content="开始捕获"
                    VerticalAlignment="Center"
                    Click="OnCaptureClick" />
        </Grid>

        <ComboBox x:Name="PresetCombo"
                  Header="常用动作"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="选择一个预置动作"
                  SelectionChanged="OnPresetChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:ActionPreset">
                    <Grid ColumnSpacing="24" MinWidth="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Action}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ActionBox"
                     Header="动作"
                     PlaceholderText="如 ctrl+shift+esc、run:notepad、url:https://…" />

            <Button Grid.Column="1"
                    Content="选择程序…"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,6"
                    Click="OnBrowseClick" />
        </Grid>

        <TextBlock Text="也可以直接写：run:&quot;C:\Program Files\App\App.exe&quot; 启动任意程序，url:https://… 打开网页。"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
