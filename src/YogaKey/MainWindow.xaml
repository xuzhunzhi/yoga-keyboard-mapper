<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YogaKey.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:core="using:YogaKey.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE765;" FontSize="16" />
                <TextBlock Text="YogaKey" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820"
                        Padding="28,4,28,28"
                        Spacing="16"
                        HorizontalAlignment="Stretch">

                <!-- Page header -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="特殊键映射" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="按一下 Yoga Book 蓝牙键盘上的特殊键，把它换成你想要的快捷键。"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <CommandBar Grid.Column="1"
                                DefaultLabelPosition="Right"
                                IsOpen="False"
                                Background="Transparent"
                                VerticalAlignment="Center">
                        <AppBarButton x:Name="AddButton" Icon="Add" Label="新增" Click="OnAddClick" />
                        <AppBarButton x:Name="EditButton" Icon="Edit" Label="编辑" Click="OnEditClick" IsEnabled="False" />
                        <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="删除" Click="OnDeleteClick" IsEnabled="False" />
                    </CommandBar>
                </Grid>

                <InfoBar x:Name="StatusBar"
                         IsOpen="False"
                         IsClosable="True" />

                <!-- Mapping list -->
                <Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ListView x:Name="MappingsList"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnItemClick"
                                  SelectionChanged="OnSelectionChanged"
                                  Background="Transparent"
                                  MinHeight="220"
                                  Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:MappingItem">
                                    <Grid ColumnSpacing="16" Padding="4,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="56"
                                                Height="32"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind CodeText}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ActionText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <TextBlock x:Name="EmptyText"
                               Text="还没有映射，点右上角「新增」开始"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               IsHitTestVisible="False" />
                </Grid>

                <!-- Settings -->
                <TextBlock Text="常规" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />

                <controls:SettingsCard Header="监听特殊键" Description="关闭后不再拦截键盘">
                    <ToggleSwitch x:Name="ListenToggle" IsOn="True" Toggled="OnListenToggled" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="开机自启" Description="登录 Windows 后自动运行">
                    <ToggleSwitch x:Name="AutoStartToggle" Toggled="OnAutoStartToggled" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="配置文件" Description="config.json">
                    <Button Content="打开文件夹" Click="OnOpenFolderClick" />
                </controls:SettingsCard>

                <Expander Header="高级" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <TextBox x:Name="DeviceMatchBox"
                                 Header="设备匹配 DeviceMatch"
                                 PlaceholderText="FE5A42B74943（留空表示任意设备）" />
                        <TextBox x:Name="CollectionBox"
                                 Header="集合 CollectionMatch"
                                 PlaceholderText="Col05（留空表示任意集合）" />
                        <Button Content="应用并重启监听" Click="OnApplyDeviceClick" />
                    </StackPanel>
                </Expander>

                <TextBlock Text="YogaKey 1.0.0 · MIT"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.5"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
